# Скопіюйте цей файл у .env і заповніть. Файл .env НЕ потрапляє в Git (див. .gitignore).
PORT=3000
NODE_ENV=development
# Таємний рядок для підпису токенів сесій. У production ОБОВ'ЯЗКОВИЙ (довгий випадковий).
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PEPPER=
# Шлях до файлу бази даних SQLite (за замовчуванням ./data/bookspace.db)
DB_PATH=
# Скільки днів діє сесія
SESSION_DAYS=7
# Дозволені джерела для CORS (через кому). Потрібно, лише якщо клієнт на іншому домені.
CORS_ORIGIN=
